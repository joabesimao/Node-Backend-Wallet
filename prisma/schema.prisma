generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id       Int    @id @default(autoincrement())
  name     String
  document String
}

model Stock {
  id         Int        @id @default(autoincrement())
  name       String
  valueStock Int
  Position   Position[]
}

model Position {
  id         Int   @id @default(autoincrement())
  stock      Stock @relation(fields: [stockId], references: [id])
  valueStock Int
  quantity   Int
  stockId    Int

  Wallet Wallet[]
}

model Wallet {
  id       Int        @id @default(autoincrement())
  position Position[]
}
